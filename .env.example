# Database — required before pnpm build (Prisma compiles during NestJS build)
DATABASE_URL="file:./prisma/dev.db"

# Anthropic — required for AI character responses
ANTHROPIC_API_KEY=

# API server
PORT=3001
# API bind address (loopback by default; the API has no auth)
HOST=127.0.0.1
# The only browser origin allowed to call the API: exact scheme://host:port, so
# http://127.0.0.1:3000 is a different origin. For LAN access set HOST=0.0.0.0,
# WEB_ORIGIN=http://<lan-ip>:3000 and NEXT_PUBLIC_API_URL=http://<lan-ip>:3001 (one origin only).
WEB_ORIGIN=http://localhost:3000

# Feature flags
ENABLE_LOCAL_CODEX=false
ALLOW_LOCAL_PROCESS_EXECUTION=false
ALLOW_CODEX_WORKSPACE_WRITE=false
CODEX_CWD=

# Frontend flags
NEXT_PUBLIC_ENABLE_LOCAL_CODEX_UI=false
