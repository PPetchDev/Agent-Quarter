DATABASE_URL="postgresql://postgres:password@localhost:5432/squad_dev"
ANTHROPIC_API_KEY="sk-ant-..."
# The only browser origin allowed to call the API (exact match; http://127.0.0.1:3000 is a different origin).
WEB_ORIGIN="http://localhost:3000"
PORT=3001
# Bind address. Loopback by default because the API has no auth; set 0.0.0.0 to expose it on the LAN.
HOST="127.0.0.1"
